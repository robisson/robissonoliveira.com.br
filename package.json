{
  "name": "robissonoliveira.com.br",
  "version": "1.0.0",
  "description": "My personal site",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "preview:static": "npm run build && python3 -m http.server 8080 --directory dist",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "validate": "npm run check && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robisson/robissonoliveira.com.br.git"
  },
  "author": "Robisson Oliveira",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/robisson/robissonoliveira.com.br/issues"
  },
  "homepage": "https://github.com/robisson/robissonoliveira.com.br#readme",
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3",
    "typescript": "^6.0.3"
  }
}
