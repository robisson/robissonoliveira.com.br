---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  lang?: "pt-BR" | "en";
  alternatePath?: string;
}

const {
  title,
  description = "Meu espaco para falar de desenvolvimento de software e negocios.",
  currentPath = "",
  lang = "pt-BR",
  alternatePath,
} = Astro.props;

const isEnglish = lang === "en";
const basePath = isEnglish ? "/en" : "";

const links = [
  { href: `${basePath}/`, label: isEnglish ? "Home" : "Pagina inicial", key: "home" },
  { href: `${basePath}/blog/`, label: "Blog", key: "blog" },
  { href: isEnglish ? "/livros/" : "/livros/", label: isEnglish ? "Books" : "Livros", key: "livros" },
  { href: `${basePath}/${isEnglish ? "about" : "sobre-mim"}/`, label: isEnglish ? "About" : "Sobre mim", key: "sobre" },
];

const languageHref = alternatePath ?? (isEnglish ? "/" : "/en/");
const languageLabel = isEnglish ? "PT" : "EN";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" type="application/rss+xml" title="Blog - Robisson Oliveira" href="/rss.xml" />
    <link rel="alternate" hreflang={isEnglish ? "pt-BR" : "en"} href={languageHref} />
    <title>{title}</title>
  </head>
  <body>
    <div class="top-detail-header" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
    <nav class="site-nav">
      <div class="site-nav__inner">
        <a class="site-nav__brand" href="/">Robisson Oliveira</a>
        <button
          class="site-nav__toggle"
          type="button"
          aria-label={isEnglish ? "Open menu" : "Abrir menu"}
          aria-controls="site-menu"
          aria-expanded="false"
          data-menu-toggle
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
        <div class="site-nav__overlay" data-menu-close></div>
        <div class="site-nav__links" id="site-menu" data-menu>
          <div class="site-nav__drawer-header">
            <span>Robisson Oliveira</span>
            <button
              class="site-nav__close"
              type="button"
              aria-label={isEnglish ? "Close menu" : "Fechar menu"}
              data-menu-close
            >
              x
            </button>
          </div>
          {links.map((link) => (
            <a
              class="site-nav__link"
              href={link.href}
              aria-current={currentPath === link.key ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
          <a class="site-nav__language" href={languageHref} aria-label={isEnglish ? "Ver em portugues" : "Read in English"}>
            {languageLabel}
          </a>
        </div>
      </div>
    </nav>
    <main class="page">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        {isEnglish
          ? "Robisson Oliveira - Software development, architecture and cloud."
          : "Robisson Oliveira - Desenvolvimento de software, arquitetura e cloud."}
      </div>
    </footer>
    <script>
      const toggle = document.querySelector("[data-menu-toggle]");
      const menu = document.querySelector("[data-menu]");
      const closeTargets = document.querySelectorAll("[data-menu-close]");

      function setMenuOpen(open: boolean) {
        document.body.classList.toggle("site-menu-open", open);
        toggle?.setAttribute("aria-expanded", String(open));
      }

      toggle?.addEventListener("click", () => {
        setMenuOpen(!document.body.classList.contains("site-menu-open"));
      });

      closeTargets.forEach((target) => {
        target.addEventListener("click", () => setMenuOpen(false));
      });

      menu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMenuOpen(false));
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          setMenuOpen(false);
        }
      });
    </script>
  </body>
</html>
