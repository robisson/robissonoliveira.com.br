---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { formatPostDate, postImage, postSlug, postsByLocale, translatedPostSlug } from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = postsByLocale(await getCollection("blog"), "en");

  return posts.map((post) => ({
    params: { slug: postSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const slug = postSlug(post.id);
const alternateSlug = translatedPostSlug(post.id);
const canonicalPath = `/en/blog/${slug}/`;
const alternatePath = alternateSlug ? `/blog/${alternateSlug}/` : "/blog/";
const image = postImage(post.id);
const site = Astro.site ?? new URL("https://www.robissonoliveira.com.br");
const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  image: new URL(image, site).toString(),
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: "en",
  author: {
    "@type": "Person",
    name: "Robisson Oliveira",
    url: new URL("/", site).toString(),
  },
  publisher: {
    "@type": "Person",
    name: "Robisson Oliveira",
  },
  mainEntityOfPage: new URL(canonicalPath, site).toString(),
  keywords: post.data.tags.join(", "),
};
---

<BaseLayout
  title={`${post.data.title} - Robisson Oliveira`}
  description={post.data.description}
  currentPath="blog"
  lang="en"
  alternatePath={alternatePath}
  canonicalPath={canonicalPath}
  image={image}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate ?? post.data.pubDate}
  tags={post.data.tags}
  structuredData={articleStructuredData}
>
  <article class="article">
    <header class="article__header">
      <p class="eyebrow">{post.data.series ?? "Blog"}</p>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        {formatPostDate(post.data.pubDate, "en")}
      </p>
      <div class="tag-list">
        {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>
    <div class="article__body">
      <Content />
    </div>
  </article>
</BaseLayout>
