---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { formatPostDate, postsByLocale } from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = postsByLocale(await getCollection("blog"), "en");
  const postSlug = (id: string) => id.replace(/\.md$/, "");

  return posts.map((post) => ({
    params: { slug: postSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} - Robisson Oliveira`}
  description={post.data.description}
  currentPath="blog"
  lang="en"
  alternatePath="/blog/"
>
  <article class="article">
    <header class="article__header">
      <p class="eyebrow">{post.data.series ?? "Blog"}</p>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        {formatPostDate(post.data.pubDate, "en")}
      </p>
      <div class="tag-list">
        {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </header>
    <div class="article__body">
      <Content />
    </div>
  </article>
</BaseLayout>
