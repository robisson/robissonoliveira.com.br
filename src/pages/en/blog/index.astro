---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { formatPostDate, postSlug, postsByLocale } from "../../../lib/blog";

const posts = postsByLocale(await getCollection("blog"), "en");
const featuredPost = posts[0];
const remainingPosts = posts.slice(1);
const series = Array.from(new Set(posts.map((post) => post.data.series).filter(Boolean)));
const tags = Array.from(new Set(posts.flatMap((post) => post.data.tags))).sort();
---

<BaseLayout
  title="Blog - Robisson Oliveira"
  description="Articles by Robisson Oliveira about architecture, cloud and software engineering."
  currentPath="blog"
  lang="en"
  alternatePath="/blog/"
>
  <section class="blog-header">
    <div>
      <p class="eyebrow">Blog</p>
      <h1>Articles on architecture, cloud and engineering.</h1>
    </div>
    <p>
      Markdown posts, versioned in Git, published as static HTML. Clean reading, responsive layout and no platform lock-in.
    </p>
  </section>

  {featuredPost ? (
    <section class="blog-featured">
      <article>
        <p class="post-card__meta">
          {formatPostDate(featuredPost.data.pubDate, "en")}
          {featuredPost.data.series ? ` - ${featuredPost.data.series}` : ""}
        </p>
        <h2><a href={`/en/blog/${postSlug(featuredPost.id)}/`}>{featuredPost.data.title}</a></h2>
        <p>{featuredPost.data.description}</p>
        <div class="tag-list">
          {featuredPost.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </article>
    </section>
  ) : (
    <p>No English posts yet.</p>
  )}

  <section class="blog-layout">
    <div class="post-list post-list--grid">
      {remainingPosts.map((post) => (
        <article class="post-card">
          <p class="post-card__meta">
            {formatPostDate(post.data.pubDate, "en")}
            {post.data.series ? ` - ${post.data.series}` : ""}
          </p>
          <h2 class="post-card__title">
            <a href={`/en/blog/${postSlug(post.id)}/`}>{post.data.title}</a>
          </h2>
          <p class="post-card__description">{post.data.description}</p>
          <div class="tag-list">
            {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </article>
      ))}
    </div>

    <aside class="blog-aside">
      <section>
        <h2>Series</h2>
        <div class="tag-list">
          {series.map((name) => <span class="tag tag--soft">{name}</span>)}
        </div>
      </section>
      <section>
        <h2>Topics</h2>
        <div class="tag-list">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </section>
      <a class="rss-link" href="/en/rss.xml">Blog RSS</a>
    </aside>
  </section>
</BaseLayout>
