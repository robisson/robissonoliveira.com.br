---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPostDate, postImage, postSlug, postsByLocale } from "../../lib/blog";

const posts = postsByLocale(await getCollection("blog"), "en");
const latestPost = posts[0];
---

<BaseLayout
  title="Robisson Oliveira - Principal Cloud Application Architect"
  description="Robisson Oliveira personal site about software architecture, cloud, resilience, open source projects, articles and books."
  currentPath="home"
  lang="en"
  alternatePath="/"
  canonicalPath="/en/"
  type="profile"
>
  <section class="legacy-feature" id="last-article">
    <div class="legacy-feature__copy">
      <span class="legacy-label">Latest article</span>
      {latestPost && (
        <>
          <img src={postImage(latestPost.id)} alt={latestPost.data.title} class="legacy-feature__image legacy-feature__image--mobile" />
          <h1>{latestPost.data.title}</h1>
          <small>{formatPostDate(latestPost.data.pubDate, "en")}</small>
          <p class="lead">{latestPost.data.description}</p>
          <p class="text-right"><a href={`/en/blog/${postSlug(latestPost.id)}/`}>Read full article</a></p>
        </>
      )}
    </div>
    <div>
      {latestPost && (
        <img src={postImage(latestPost.id)} alt={latestPost.data.title} class="legacy-feature__image legacy-feature__image--desktop" />
      )}
    </div>
  </section>

  <section class="legacy-presentation" id="home-presentation">
    <img class="legacy-profile" src="/assets/images/robisson-home.png" alt="Robisson Oliveira" />
    <div>
      <h3>Robisson Oliveira</h3>
      <p>I currently work as a Principal Cloud Application Architect at Amazon Web Services (AWS).</p>
      <p>I built this site to share knowledge about things I enjoy and to reinforce what I learn.</p>
    </div>
    <div class="legacy-social">
      <a title="LinkedIn profile" href="https://www.linkedin.com/in/robisson/"><img src="/assets/images/linkedin.png" alt="LinkedIn profile" /></a>
      <a title="Medium profile" href="https://medium.com/@robisson"><img src="/assets/images/medium.png" alt="Medium profile" /></a>
      <a title="GitHub profile" href="https://github.com/robisson"><img src="/assets/images/github.png" alt="GitHub profile" /></a>
      <a title="Twitter profile" href="https://twitter.com/robissonmkt"><img src="/assets/images/twitter.png" alt="Twitter profile" /></a>
    </div>
  </section>

  <section class="legacy-section" id="what-i-reading">
    <header class="legacy-section__header">
      <h2>What I am reading</h2>
      <p>I read a lot. Books are my preferred way to learn something new.</p>
    </header>
    <div class="legacy-reading">
      <img src="/blog/wp-content/uploads/books/agentic-mesh.jpg" alt="Agentic Mesh: The GenAI-Powered Autonomous Agent Ecosystem" />
      <div>
        <h2>Agentic Mesh: The GenAI-Powered Autonomous Agent Ecosystem</h2>
        <h4>Eric Broda, Davis Broda</h4>
        <p>With the rise of autonomous agents, the question is no longer "How do we build agents?" but rather, "How do we manage an entire ecosystem of them?" The book explores interconnected agents that collaborate, transact, and fulfill tasks autonomously through an agentic mesh architecture.</p>
        <p><a href="/livros/">See the books I have logged</a>.</p>
      </div>
    </div>
  </section>

  <section class="legacy-section" id="open-source-project">
    <header class="legacy-section__header">
      <h2>Open Source Projects</h2>
      <p>I try to contribute to the open source community whenever possible.</p>
    </header>
    <div class="legacy-project">
      <img src="/assets/images/build-like-amazon.png" alt="Build Like Amazon Agent Skills" />
      <div class="legacy-project__copy">
        <h2>Build Like Amazon Agent Skills</h2>
        <p>An open source library of skills, commands, and agent personas that guides AI coding agents through engineering workflows inspired by how Amazon builds, operates, and evolves distributed services.</p>
        <p>The project organizes 27 skills and 10 bar raiser personas across working backwards, design, build, review, deployment, operations, and learning from incidents.</p>
        <p class="text-right"><a href="https://github.com/robisson/build-like-amazon-agent-skills">View on github.com</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
