---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPostDate, postImage, postSlug, postsByLocale, translatedPostSlug } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = postsByLocale(await getCollection("blog"), "pt-BR");

  return posts.map((post) => ({
    params: { slug: postSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const slug = postSlug(post.id);
const alternateSlug = translatedPostSlug(post.id);
const canonicalPath = `/blog/${slug}/`;
const alternatePath = alternateSlug ? `/en/blog/${alternateSlug}/` : "/en/blog/";
const image = postImage(post.id);
const pageTitle = post.data.seoTitle ?? post.data.title;
const site = Astro.site ?? new URL("https://www.robissonoliveira.com.br");
const articleUrl = new URL(canonicalPath, site).toString();
const encodedArticleUrl = encodeURIComponent(articleUrl);
const encodedTitle = encodeURIComponent(post.data.title);
const shareLinks = [
  {
    label: "LinkedIn",
    ariaLabel: "Compartilhar no LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedArticleUrl}`,
    icon:
      '<svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M6.94 8.92v9.31H3.84V8.92h3.1ZM5.39 4.28c.99 0 1.79.8 1.79 1.78s-.8 1.79-1.79 1.79-1.78-.8-1.78-1.79.8-1.78 1.78-1.78Zm7.07 4.64.1 1.28c.45-.73 1.35-1.5 2.82-1.5 2.07 0 3.63 1.35 3.63 4.27v5.26h-3.09v-4.66c0-1.25-.44-2.1-1.53-2.1-.84 0-1.34.57-1.56 1.13-.08.2-.1.48-.1.75v4.88H9.64V8.92h2.82Z"/></svg>',
  },
  {
    label: "X",
    ariaLabel: "Compartilhar no X",
    href: `https://twitter.com/intent/tweet?url=${encodedArticleUrl}&text=${encodedTitle}`,
    icon:
      '<svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M14.17 10.24 21.56 2h-1.75l-6.42 7.16L8.27 2H2.36l7.75 10.84L2.36 21.5h1.75l6.78-7.57 5.42 7.57h5.91l-8.05-11.26Zm-2.4 2.68-.78-1.08L4.74 3.27h2.69l5.04 6.92.78 1.08 6.56 8.99h-2.69l-5.35-7.34Z"/></svg>',
  },
  {
    label: "WhatsApp",
    ariaLabel: "Compartilhar no WhatsApp",
    href: `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedArticleUrl}`,
    icon:
      '<svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M12.04 3.4a8.43 8.43 0 0 0-7.2 12.8l-.93 3.4 3.48-.91a8.43 8.43 0 1 0 4.65-15.29Zm0 1.57a6.86 6.86 0 0 1 5.82 10.49 6.85 6.85 0 0 1-9.96 1.73l-.25-.15-2.07.54.55-2.01-.17-.26a6.86 6.86 0 0 1 6.08-10.34Zm-2.8 3.74c-.15 0-.39.06-.6.29-.2.23-.78.76-.78 1.86s.8 2.16.91 2.31c.11.15 1.55 2.49 3.85 3.39 1.9.75 2.29.6 2.7.56.42-.04 1.35-.55 1.54-1.08.19-.53.19-.99.13-1.08-.06-.1-.21-.15-.44-.27-.23-.11-1.35-.67-1.56-.74-.21-.08-.36-.11-.52.11-.15.23-.59.74-.72.89-.13.15-.27.17-.5.06-.23-.11-.96-.35-1.83-1.13-.68-.6-1.14-1.35-1.27-1.58-.13-.23-.01-.35.1-.46.1-.1.23-.27.34-.4.11-.13.15-.23.23-.38.08-.15.04-.29-.02-.4-.06-.11-.52-1.25-.71-1.71-.19-.45-.38-.39-.52-.4h-.44Z"/></svg>',
  },
  {
    label: "E-mail",
    ariaLabel: "Compartilhar por e-mail",
    href: `mailto:?subject=${encodedTitle}&body=${encodedArticleUrl}`,
    icon:
      '<svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm-.4 4.25-6.55 4.18a2 2 0 0 1-2.1 0L4.4 8.25A1 1 0 0 1 5.48 6.57L12 10.72l6.52-4.15a1 1 0 1 1 1.08 1.68Z"/></svg>',
  },
];
const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  image: new URL(image, site).toString(),
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: "pt-BR",
  author: {
    "@type": "Person",
    name: "Robisson Oliveira",
    url: new URL("/", site).toString(),
  },
  publisher: {
    "@type": "Person",
    name: "Robisson Oliveira",
  },
  mainEntityOfPage: new URL(canonicalPath, site).toString(),
  keywords: post.data.tags.join(", "),
};
---

<BaseLayout
  title={`${pageTitle} - Robisson Oliveira`}
  description={post.data.description}
  currentPath="blog"
  alternatePath={alternatePath}
  canonicalPath={canonicalPath}
  image={image}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate ?? post.data.pubDate}
  tags={post.data.tags}
  structuredData={articleStructuredData}
>
  <article class="article">
    <header class="article__header">
      <p class="eyebrow">{post.data.series ?? "Blog"}</p>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        {formatPostDate(post.data.pubDate, "pt-BR")}
        {post.data.language === "en" ? " - English" : ""}
      </p>
      <div class="tag-list">
        {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
      <nav class="share-links" aria-label="Compartilhar artigo">
        <span>Compartilhar</span>
        {shareLinks.map((link) => (
          <a href={link.href} aria-label={link.ariaLabel} title={link.label} target={link.href.startsWith("mailto:") ? undefined : "_blank"} rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}>
            <span class="share-links__icon" set:html={link.icon} />
            <span class="share-links__label">{link.label}</span>
          </a>
        ))}
      </nav>
    </header>
    <div class="article__body">
      <Content />
    </div>
  </article>
</BaseLayout>
