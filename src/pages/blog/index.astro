---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPostDate, postImage, postSlug, postsByLocale } from "../../lib/blog";

const posts = postsByLocale(await getCollection("blog"), "pt-BR");

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);
const series = Array.from(new Set(posts.map((post) => post.data.series).filter(Boolean)));
const tags = Array.from(new Set(posts.flatMap((post) => post.data.tags))).sort();
---

<BaseLayout
  title="Blog - Robisson Oliveira"
  description="Artigos de Robisson Oliveira sobre arquitetura de software, cloud computing, resiliência, AWS e engenharia de software."
  currentPath="blog"
  alternatePath="/en/blog/"
  canonicalPath="/blog/"
>
  <section class="blog-header">
    <div>
      <h1 class="blog-title">Blog</h1>
    </div>
  </section>

  {featuredPost && (
    <section class="blog-featured">
      <article>
        <a class="blog-featured__image" href={`/blog/${postSlug(featuredPost.id)}/`} aria-label={featuredPost.data.title}>
          <img src={postImage(featuredPost.id)} alt={featuredPost.data.title} />
        </a>
        <div>
          <p class="post-card__meta">
            {formatPostDate(featuredPost.data.pubDate, "pt-BR")}
            {featuredPost.data.series ? ` - ${featuredPost.data.series}` : ""}
          </p>
          <h2><a href={`/blog/${postSlug(featuredPost.id)}/`}>{featuredPost.data.title}</a></h2>
          <p>{featuredPost.data.description}</p>
          <div class="tag-list">
            {featuredPost.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </div>
      </article>
    </section>
  )}

  <section class="blog-layout">
    <div class="post-list post-list--grid">
      {remainingPosts.map((post) => (
        <article class="post-card">
          <a class="post-card__image" href={`/blog/${postSlug(post.id)}/`} aria-label={post.data.title}>
            <img src={postImage(post.id)} alt={post.data.title} />
          </a>
          <p class="post-card__meta">
            {formatPostDate(post.data.pubDate, "pt-BR")}
            {post.data.series ? ` - ${post.data.series}` : ""}
          </p>
          <h2 class="post-card__title">
            <a href={`/blog/${postSlug(post.id)}/`}>{post.data.title}</a>
          </h2>
          <p class="post-card__description">{post.data.description}</p>
          <div class="tag-list">
            {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        </article>
      ))}
    </div>

    <aside class="blog-aside">
      <section>
        <h2>Series</h2>
        <div class="tag-list">
          {series.map((name) => <span class="tag tag--soft">{name}</span>)}
        </div>
      </section>
      <section>
        <h2>Temas</h2>
        <div class="tag-list">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </section>
      <a class="rss-link" href="/rss.xml">RSS do blog</a>
    </aside>
  </section>
</BaseLayout>
