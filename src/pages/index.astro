---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatPostDate, postImage, postSlug, postsByLocale } from "../lib/blog";

const posts = postsByLocale(await getCollection("blog"), "pt-BR");
const latestPost = posts[0];
const latestCards = posts.slice(0, 2);
---

<BaseLayout
  title="Robisson Oliveira - Principal Cloud Application Architect"
  description="Site pessoal de Robisson Oliveira sobre arquitetura de software, cloud, resiliencia, projetos open source, artigos e livros."
  currentPath="home"
  alternatePath="/en/"
  canonicalPath="/"
  type="profile"
>
  <section class="legacy-feature" id="last-article">
    <div class="legacy-feature__copy">
      <span class="legacy-label">Ultimo artigo</span>
      {latestPost && (
        <>
      <img
        src={postImage(latestPost.id)}
        alt={latestPost.data.title}
        class="legacy-feature__image legacy-feature__image--mobile"
      />
      <h1>{latestPost.data.title}</h1>
      <small>{formatPostDate(latestPost.data.pubDate, "pt-BR")}</small>
      <p class="lead">{latestPost.data.description}</p>
      <p class="text-right">
        <a href={`/blog/${postSlug(latestPost.id)}/`}>Ler artigo completo</a>
      </p>
        </>
      )}
    </div>
    <div>
      {latestPost && (
      <img
        src={postImage(latestPost.id)}
        alt={latestPost.data.title}
        class="legacy-feature__image legacy-feature__image--desktop"
      />
      )}
    </div>
  </section>

  <section class="legacy-presentation" id="home-presentation">
    <img class="legacy-profile" src="/assets/images/robisson-home.png" alt="Robisson Oliveira" />
    <div>
      <h3>Robisson Oliveira</h3>
      <p>Atualmente trabalho como Principal Cloud Application Architect na Amazon Web Services (AWS).</p>
      <p>Fiz esse site para compartilhar conhecimentos das coisas que gosto e tambem reforcar o que ja sei.</p>
    </div>
    <div class="legacy-social">
      <a title="Perfil no Linkedin" href="https://www.linkedin.com/in/robisson/">
        <img src="/assets/images/linkedin.png" alt="Perfil no Linkedin" />
      </a>
      <a title="Perfil no Medium" href="https://medium.com/@robisson">
        <img src="/assets/images/medium.png" alt="Perfil no Medium" />
      </a>
      <a title="Perfil no Github" href="https://github.com/robisson">
        <img src="/assets/images/github.png" alt="Perfil no Github" />
      </a>
      <a title="Perfil no Twitter" href="https://twitter.com/robissonmkt">
        <img src="/assets/images/twitter.png" alt="Perfil no Twitter" />
      </a>
    </div>
  </section>

  <section class="legacy-section" id="what-i-reading">
    <header class="legacy-section__header">
      <h1>O que estou lendo</h1>
      <p>Eu costumo ler bastante, estou sempre lendo algum livro. E meu jeito preferido de aprender algo novo.</p>
    </header>
    <div class="legacy-reading">
      <img
        src="/blog/wp-content/uploads/books/agentic-mesh.jpg"
        alt="Agentic Mesh: The GenAI-Powered Autonomous Agent Ecosystem"
      />
      <div>
        <h2>Agentic Mesh: The GenAI-Powered Autonomous Agent Ecosystem</h2>
        <h4>Eric Broda, Davis Broda</h4>
        <p>
          Com a ascensao dos agentes autonomos, a pergunta deixa de ser "como construimos agentes?" e passa a ser "como gerenciamos um ecossistema inteiro deles?". O livro explora agentes interconectados que colaboram, transacionam e executam tarefas de forma autonoma, usando o conceito de agentic mesh para operar esse ecossistema em escala.
        </p>
        <p>Gosto de registrar os livros que ja li. Venho fazendo isso desde 2013. <a href="/livros/">Aqui tem uma lista de outros livros que ja li</a>.</p>
      </div>
    </div>
  </section>

  <section class="legacy-section" id="last-articles">
    <header class="legacy-section__header">
      <h1>Ultimos artigos</h1>
      <p>Estou tentando escrever um post por semana, nem sempre e possivel.</p>
    </header>
    <div class="legacy-article-grid">
      {latestCards.map((post) => (
        <article class="legacy-article-card">
          <img src={postImage(post.id)} alt={post.data.title} />
          <h3>{post.data.title}</h3>
          <p>{formatPostDate(post.data.pubDate, "pt-BR")}</p>
          <a href={`/blog/${postSlug(post.id)}/`}>Ler artigo completo</a>
        </article>
      ))}
    </div>
  </section>

  <section class="legacy-section" id="open-source-project">
    <header class="legacy-section__header">
      <h1>Projetos Open Source</h1>
      <p>Estou tentando na medida do possivel contribuir com a comunidade open source.</p>
    </header>
    <div class="legacy-project">
      <img src="/assets/images/build-like-amazon.png" alt="Build Like Amazon Agent Skills" />
      <div class="legacy-project__copy">
        <h2>Build Like Amazon Agent Skills</h2>
        <p>Uma biblioteca open source de skills, comandos e agentes para orientar agentes de IA em fluxos de engenharia inspirados em como a Amazon cria, opera e evolui servicos distribuidos.</p>
        <p>O projeto organiza 27 skills e 10 personas bar raiser cobrindo working backwards, design, build, review, deploy, operacao e aprendizado com incidentes.</p>
        <p class="text-right"><a href="https://github.com/robisson/build-like-amazon-agent-skills">Ver no github.com</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
